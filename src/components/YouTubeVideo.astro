---
// Click-to-play YouTube embed: shows the thumbnail until clicked, so the page doesn't load
// YouTube's player up front. Also outputs VideoObject schema for the video.
import type { Video } from '../data/videos';
interface Props { video: Video; caption?: string; }
const { video, caption } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`;
const watchUrl = `https://www.youtube.com/watch?v=${video.id}`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: video.description,
  thumbnailUrl: [thumb],
  uploadDate: video.uploadDate,
  duration: video.duration,
  contentUrl: watchUrl,
  embedUrl: `https://www.youtube-nocookie.com/embed/${video.id}`,
};
---
<figure class="yt-video">
  <div class="yt-frame">
    <a href={watchUrl} data-yt={video.id} data-title={video.title} aria-label={`Play video: ${video.title}`}>
      <img src={thumb} alt={video.title} loading="lazy" decoding="async" width="480" height="360" />
      <span class="yt-play" aria-hidden="true"></span>
    </a>
  </div>
  {caption && <figcaption class="small">{caption}</figcaption>}
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</figure>
<style>
  .yt-video { margin: 1.5rem 0; }
  .yt-frame { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; background: #000; }
  .yt-frame a { position: absolute; inset: 0; }
  .yt-frame img, .yt-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt-play { position: absolute; top: 50%; left: 50%; width: 68px; height: 48px; margin: -24px 0 0 -34px; border-radius: 12px; background: var(--accent); }
  .yt-play::after { content: ''; position: absolute; top: 50%; left: 50%; margin: -10px 0 0 -6px; border-style: solid; border-width: 10px 0 10px 17px; border-color: transparent transparent transparent #fff; }
  .yt-frame a:hover .yt-play, .yt-frame a:focus-visible .yt-play { background: var(--accent-dark); }
</style>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-yt]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = a.dataset.title ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      a.replaceWith(iframe);
    });
  });
</script>
