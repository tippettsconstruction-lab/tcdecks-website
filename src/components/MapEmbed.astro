---
// Google Maps embed of the TC Decks Business Profile (service-area business, no street address shown).
// Loads lazily so it doesn't slow the page.
import { business } from '../data/site';
---
<div class="map-embed">
  <iframe
    src="https://maps.google.com/maps?cid=10136180923235134055&output=embed"
    title="TC Decks on Google Maps: Saratoga Springs, Utah, serving Utah County and Salt Lake County"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
  <p class="map-cap"><a href={business.social.google} target="_blank" rel="noopener">Open TC Decks on Google Maps</a> to see reviews, photos and directions.</p>
</div>
<style>
  .map-embed iframe { width: 100%; height: 360px; border: 0; border-radius: 12px; display: block; }
  .map-cap { font-size: .9rem; margin-top: 8px; }
</style>
