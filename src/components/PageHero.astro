---
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: { name: string; path: string }[]; }
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>{crumbs.map((c) => <> / <a href={c.path}>{c.name}</a></>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>.hero { background: var(--surface); padding: 48px 0 40px; border-bottom: 1px solid var(--line); }</style>
