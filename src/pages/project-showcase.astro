---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { projects as galleries } from '../data/projects';
import { breadcrumbSchema } from '../lib/schema';

---
<Base
  title="Deck Projects & Photo Gallery | Utah County | TC Decks"
  description="See composite decks, pergolas, stairs and railings built by TC Decks in Saratoga Springs, Lehi, Provo and across Utah County."
  schema={[breadcrumbSchema([{ name: 'Projects', path: '/project-showcase' }])]}
>
  <PageHero eyebrow="Our work" title="Deck projects across Utah County" lead="A few recent builds. Ask us for addresses of finished decks near you that you can drive by." crumbs={[{ name: 'Projects', path: '/project-showcase' }]} />
  {galleries.map((g) => (
    <section class="section">
      <div class="wrap">
        <h2 id={g.slug}>{g.title}</h2>
        <p class="lead">{g.summary}</p>
        <div class="grid grid-3">{g.photos.map((ph) => <Photo src={ph.src} alt={ph.alt} />)}</div>
      </div>
    </section>
  ))}
  <section class="section alt">
    <div class="wrap"><h2>Want to see more?</h2><p>Browse hundreds of photos by feature in our <a href="/design-ideas">design ideas</a>, or follow us on <a href="https://www.instagram.com/tcdecks/">Instagram</a>.</p></div>
  </section>
</Base>
<style>.proj { margin: 0; } figcaption { margin-top: 8px; color: var(--ink-soft); }</style>
