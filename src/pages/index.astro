---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import Faqs from '../components/Faqs.astro';
import { business, cities, brands, yearsInBusiness } from '../data/site';
import { faqSchema } from '../lib/schema';

const faqs = [
  { q: 'How much does a new deck cost in Utah County?', a: 'It depends mostly on size, height and material. Our deck cost guide breaks down typical price ranges for wood and composite decks, railings, stairs and pergolas, and every estimate we give is free and itemized.' },
  { q: 'Do you handle permits?', a: 'Yes. We draw the plans, pull the city permit and schedule the inspections for you in every city we serve.' },
  { q: 'Can I see my deck before it is built?', a: 'Yes. We create a 3D design of your deck on your home so you can see the layout, colors and railing before we start.' },
  { q: 'What warranty do you offer?', a: 'Every deck includes a one-year workmanship warranty, on top of the manufacturer warranty for your decking and railing, which is 25 years or more on most composite lines.' },
];
---
<Base
  title="Deck Builder in Saratoga Springs & Utah County | TC Decks"
  description={`Custom composite and wood decks, pergolas and deck repair in Saratoga Springs, Lehi, Eagle Mountain and Utah County. Licensed & insured, ${yearsInBusiness}+ years. Free 3D design and estimate.`}
  schema={[faqSchema(faqs)]}
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Utah County deck builder since {business.founded}</p>
        <h1>Custom decks built for Utah weather and how your family lives</h1>
        <p class="lead">TC Decks designs and builds composite decks, pergolas and porches across Saratoga Springs, Lehi, Eagle Mountain and the rest of Utah County. You see your deck in 3D before we start, and Levi runs your project from permit to final walkthrough.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact">Get a Free Estimate</a>
          <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <ul class="trust">
          <li>★ {business.rating.value} from {business.rating.count} Google reviews</li>
          <li>Licensed &amp; insured · #{business.license}</li>
          <li>{yearsInBusiness}+ years building decks</li>
        </ul>
      </div>
      <Photo alt="Composite deck with pergola built by TC Decks" label="Hero photo: best recent deck project" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we build</p>
      <h2>Decks, pergolas and porches, start to finish</h2>
      <ServiceCards />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid grid-2 align">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>A simple, four-step process</h2>
        <ol class="steps">
          <li><strong>Free consultation.</strong> We visit, measure and talk through how you want to use the space, your budget and timing.</li>
          <li><strong>3D design and quote.</strong> You get a 3D rendering of the deck on your home and a clear, itemized price.</li>
          <li><strong>Permit and build.</strong> We pull the permit, build to code and keep you updated through every inspection.</li>
          <li><strong>Walkthrough and warranty.</strong> Final walkthrough, cleanup, and a one-year workmanship warranty plus the manufacturer's material warranty.</li>
        </ol>
      </div>
      <Photo alt="3D deck design rendering" label="Photo: 3D rendering next to the finished deck" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Recent work</p>
      <h2>Projects around Utah County</h2>
      <div class="grid grid-3">
        <Photo alt="Trex Transcend deck in Lava Rock with hidden fasteners" label="Trex Transcend · Lava Rock" />
        <Photo alt="Provo deck remodel with Pebble Grey Trex and white vinyl railing" label="Provo · Pebble Grey Trex remodel" />
        <Photo alt="Custom deck stairs in Trex Transcend Spiced Rum" label="Trex Transcend · Spiced Rum stairs" />
      </div>
      <p style="margin-top:18px"><a class="btn btn-ghost" href="/project-showcase">See all projects</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Reviews</p>
      <h2>What homeowners say</h2>
      <Reviews />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <p class="eyebrow">Materials</p>
        <h2>Composite brands we install</h2>
        <p>We install the major composite and railing lines and will walk you through the real differences in heat, color, warranty and price.</p>
        <ul class="check-list">{brands.map((b) => <li>{b}</li>)}</ul>
        <a class="more" href="/composite-decks">Compare composite decking →</a>
      </div>
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Where we build</h2>
        <p>Based in Saratoga Springs and building throughout Utah County.</p>
        <ul class="city-list">{cities.map((c) => <li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      <Faqs faqs={faqs} />
      <p><a href="/how-much-does-a-deck-cost-in-utah">See our Utah deck cost guide →</a></p>
    </div>
  </section>
</Base>

<style>
  .home-hero { background: var(--sand); padding: 56px 0; }
  .hero-grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr; } }
  .trust { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; color: var(--green); font-size: 0.95rem; }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.8rem; }
  .align { align-items: center; }
  .city-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .more { font-weight: 700; }
</style>
