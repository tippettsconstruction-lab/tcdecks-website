---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import Faqs from '../components/Faqs.astro';
import { business, cities, brands, yearsInBusiness } from '../data/site';
import { faqSchema } from '../lib/schema';

const faqs = [
  { q: 'How much does a new deck cost?', a: 'It depends mostly on size, height, material and add-ons like railing, stairs and pergolas. Call or send us your project details and we’ll give you a free estimate over the phone.' },
  { q: 'Can I see my deck before it is built?', a: 'Yes. Once your project is booked, we create a 3D design of your deck on your home so you can see the layout, colors and railing before construction starts.' },
  { q: 'What warranty do you offer?', a: 'Every deck includes a 7-year workmanship warranty, on top of the manufacturer warranty for your decking and railing. Because we are a certified Pro Installer for TimberTech, Trex, Deckorators and Fortress, that manufacturer coverage can include labor as well as material.' },
];
---
<Base
  title="Deck Builder Utah County | Saratoga Springs | TC Decks"
  description={`Custom composite decks, pergolas and full deck rebuilds across Utah & Salt Lake Counties. Licensed & insured for ${yearsInBusiness}+ years, with a 7-year workmanship warranty.`}
  schema={[faqSchema(faqs)]}
>
  <link slot="head" rel="preload" as="image" href="/video/tc-decks-deck-builds-poster.webp" fetchpriority="high" />
  <section class="home-hero">
    <div class="hero-video" aria-hidden="false">
        <video autoplay muted loop playsinline preload="metadata" poster="/video/tc-decks-deck-builds-poster.webp" aria-label="Drone and close-up footage of composite decks built by TC Decks">
          <source src="/video/tc-decks-deck-builds.mp4" type="video/mp4" />
        </video>
      </div>
    <div class="hero-shade"></div>
    <div class="wrap hero-content">
      <div>
        <p class="eyebrow">Wasatch Front deck builder since {business.founded}</p>
        <h1>Utah County Deck Builder: Custom Decks Built for Utah Weather</h1>
        <p class="lead">TC Decks designs and builds composite decks, pergolas and porches across Saratoga Springs, Lehi, Eagle Mountain and the rest of Utah County, plus Draper, Herriman and southern Salt Lake County. Estimates are free, every booked project gets a 3D design, and Levi runs your project from the first call to the final walkthrough.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact">Get a Free Estimate</a>
          <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <ul class="trust">
          <li>★ {business.rating.value} from {business.rating.count} Google reviews</li>
          <li>Licensed &amp; insured · #{business.license}</li>
          <li>{yearsInBusiness}+ years building decks</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we build</p>
      <h2>Decks, pergolas and porches, start to finish</h2>
      <ServiceCards />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid grid-2 align">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>A simple, four-step process</h2>
        <ol class="steps">
          <li><strong>Free phone estimate.</strong> Tell us how you want to use the space, your budget and timing, and we'll give you a ballpark price. If it's a good fit, we come out to measure and finalize the quote.</li>
          <li><strong>3D design.</strong> Once you book, we create a 3D rendering of the deck on your home so you can finalize every detail.</li>
          <li><strong>Build.</strong> We build to code and keep you updated from start to finish.</li>
          <li><strong>Walkthrough and warranty.</strong> Final walkthrough, cleanup, and a 7-year workmanship warranty plus manufacturer labor and material warranty coverage.</li>
        </ol>
      </div>
      <Photo src="/images/projects/covered-deck-roof/3d-rendering-covered-deck-4" alt="3D rendering of a covered deck designed by TC Decks" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Recent work</p>
      <h2>Projects around Utah County</h2>
      <div class="grid grid-3">
        <a href="/project-showcase"><Photo src="/images/projects/saratoga-springs-french-white-oak/timbertech-french-white-oak-american-walnut-steps" alt="Two-tone TimberTech deck with step lights in Saratoga Springs" /></a>
        <a href="/design-ideas/roofs-shade"><Photo src="/images/ideas/gable-roof-covered-deck-stone-columns" alt="Covered deck with a vaulted gable roof and stone columns" /></a>
        <a href="/design-ideas/lighting"><Photo src="/images/ideas/covered-deck-lighting-night" alt="Covered deck and stairs lit up at night" /></a>
      </div>
      <p style="margin-top:18px"><a class="btn btn-ghost" href="/project-showcase">See all projects</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Reviews</p>
      <h2>What homeowners say</h2>
      <Reviews />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2 align">
      <div>
        <p class="eyebrow">Built for Utah weather</p>
        <h2>Decks made for Utah County sun, snow and freeze-thaw</h2>
        <p>A deck in Utah County takes a beating. Summer sun at 4,500 feet fades and dries out boards, winter brings heavy snow loads, and spring and fall swing above and below freezing day after day. As a Utah County deck contractor, we build for those conditions from the ground up.</p>
        <ul class="check-list">
          <li><strong>Footings that stay put.</strong> We set footings below the frost line or use American Ground Screw footings, so your deck doesn't heave or sink.</li>
          <li><strong>Frames that don't rot.</strong> Fortress Evolution steel framing and OC Lumber won't rot, warp or attract insects. On wood frames we cover every joist with G-Tape so water can't sit in screw holes.</li>
          <li><strong>Boards that hold their color.</strong> Capped composite and PVC decking resists fading, staining and moisture, and lighter colors stay cooler underfoot on west-facing decks.</li>
          <li><strong>Railing and stairs built for snow.</strong> Powder-coated aluminum and steel railing won't rust, and we plan stairs and drainage so snow melt runs off instead of pooling.</li>
        </ul>
        <a class="more" href="/design-ideas/built-to-last">How we build decks that last →</a>
      </div>
      <div>
        <p class="eyebrow">Why TC Decks</p>
        <h2>What you get with a local, owner-run builder</h2>
        <ul class="check-list">
          <li>Free estimates over the phone, with no waiting for an appointment.</li>
          <li>A 3D rendering of your deck on your home once your project is booked.</li>
          <li>Levi Tippetts, the owner, involved from the first call to the final walkthrough.</li>
          <li>A 7-year workmanship warranty, plus manufacturer labor and material coverage as a certified Pro Installer.</li>
          <li>Financing through Wisetack, with loans up to $65,000.</li>
          <li>More than {yearsInBusiness} years building decks for Utah County families.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <div>
        <h2>Get a free deck estimate</h2>
        <p>Tell us about your project and get a ballpark price over the phone. We serve Utah County communities from Lehi to Payson, plus southern Salt Lake County.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="/contact">Get a Free Estimate</a>
        <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <p class="eyebrow">Materials</p>
        <h2>Brands we build with</h2>
        <p>We're a <a href="/certified-pro-installer">certified Pro Installer</a> (TimberTech Platinum) for TimberTech, Trex, Deckorators and Fortress, and part of the <a href="/oc-lumber">OC Pro Build Team</a> for wood-free, rot-proof OC Lumber. We'll walk you through the real differences in heat, color, warranty and budget.</p>
        <ul class="check-list">{brands.map((b) => <li>{b}</li>)}</ul>
        <a class="more" href="/design-ideas">Browse design ideas →</a>
      </div>
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Where we build</h2>
        <p>We're based in Saratoga Springs and build throughout Utah County, from Lehi, Eagle Mountain, American Fork and Highland in the north to Orem, Provo, Spanish Fork and Payson in the south. We also build in southern Salt Lake County, including Draper, Sandy, South Jordan and Herriman. Pick your city to see local projects and details.</p>
        <ul class="city-list">{cities.map((c) => <li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      <Faqs faqs={faqs} />
      <p><a href="/contact">Get your free estimate →</a></p>
    </div>
  </section>
</Base>

<style>
  .home-hero { position: relative; overflow: hidden; background: #111; color: #fff; min-height: min(88vh, 760px); display: flex; align-items: center; padding: 72px 0; }
  .hero-video, .hero-shade { position: absolute; inset: 0; }
  .hero-video video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-shade { background: linear-gradient(90deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.55) 45%, rgba(0,0,0,0.15) 100%); }
  @media (max-width: 899px) { .hero-shade { background: rgba(0,0,0,0.6); } }
  .hero-content { position: relative; }
  .hero-content > div { max-width: 40rem; }
  .home-hero h1 { color: #fff; }
  .home-hero .lead { color: rgba(255,255,255,0.9); }
  .home-hero .eyebrow { color: #ff4d55; }
  .home-hero .btn-ghost { color: #fff; }
  .trust { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; color: #fff; font-size: 0.95rem; }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.8rem; }
  .align { align-items: center; }
  .city-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .more { font-weight: 700; }
  .cta-band { background: #111; color: #fff; padding: 48px 0; }
  .cta-band .wrap { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .cta-band h2 { color: #fff; margin-bottom: 0.4rem; }
  .cta-band p { color: rgba(255,255,255,0.85); margin: 0; max-width: 40rem; }
  .cta-band .btn-ghost { color: #fff; }
</style>

<script>
  // Respect reduced-motion: show the poster frame instead of looping video.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.hero-video video').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
