---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Reviews from '../components/Reviews.astro';
import Faqs from '../components/Faqs.astro';
import { business, cities, brands, yearsInBusiness } from '../data/site';
import { faqSchema } from '../lib/schema';

const faqs = [
  { q: 'How much does a new deck cost?', a: 'It depends mostly on size, height, material and add-ons like railing, stairs and pergolas. Call or send us your project details and we’ll give you a free estimate over the phone.' },
  { q: 'Do you handle permits?', a: 'Yes. We draw the plans, pull the city permit and schedule the inspections for you in every city we serve.' },
  { q: 'Can I see my deck before it is built?', a: 'Yes. Once your project is booked, we create a 3D design of your deck on your home so you can see the layout, colors and railing before construction starts.' },
  { q: 'What warranty do you offer?', a: 'Every deck includes a 7-year workmanship warranty, on top of the manufacturer warranty for your decking and railing. Because we are a certified Pro Installer for TimberTech, Trex, Deckorators and Fortress, that manufacturer coverage can include labor as well as material.' },
];
---
<Base
  title="Deck Builder in Saratoga Springs & Utah County | TC Decks"
  description={`Custom composite and wood decks, pergolas and deck repair in Saratoga Springs, Lehi, Eagle Mountain and Utah County. Licensed & insured, ${yearsInBusiness}+ years. Free estimates, 7-year workmanship warranty.`}
  schema={[faqSchema(faqs)]}
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Utah County deck builder since {business.founded}</p>
        <h1>Custom decks built for Utah weather and how your family lives</h1>
        <p class="lead">TC Decks designs and builds composite decks, pergolas and porches across Saratoga Springs, Lehi, Eagle Mountain and the rest of Utah County. Estimates are free, every booked project gets a 3D design, and Levi runs your project from permit to final walkthrough.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact">Get a Free Estimate</a>
          <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <ul class="trust">
          <li>★ {business.rating.value} from {business.rating.count} Google reviews</li>
          <li>Licensed &amp; insured · #{business.license}</li>
          <li>{yearsInBusiness}+ years building decks</li>
        </ul>
      </div>
      <div class="photo real hero-video">
        <video autoplay muted loop playsinline preload="metadata" poster="/video/tc-decks-deck-builds-poster.webp" aria-label="Drone and close-up footage of composite decks built by TC Decks">
          <source src="/video/tc-decks-deck-builds.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What we build</p>
      <h2>Decks, pergolas and porches, start to finish</h2>
      <ServiceCards />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid grid-2 align">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>A simple, four-step process</h2>
        <ol class="steps">
          <li><strong>Free phone estimate.</strong> Tell us how you want to use the space, your budget and timing, and we'll give you a ballpark price. If it's a good fit, we come out to measure and finalize the quote.</li>
          <li><strong>3D design.</strong> Once you book, we create a 3D rendering of the deck on your home so you can finalize every detail.</li>
          <li><strong>Permit and build.</strong> We pull the permit, build to code and keep you updated through every inspection.</li>
          <li><strong>Walkthrough and warranty.</strong> Final walkthrough, cleanup, and a 7-year workmanship warranty plus manufacturer labor and material warranty coverage.</li>
        </ol>
      </div>
      <Photo src="/images/projects/covered-deck-roof/3d-rendering-covered-deck-4" alt="3D rendering of a covered deck designed by TC Decks" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Recent work</p>
      <h2>Projects around Utah County</h2>
      <div class="grid grid-3">
        <a href="/project-showcase"><Photo src="/images/projects/saratoga-springs-french-white-oak/timbertech-french-white-oak-american-walnut-steps" alt="Two-tone TimberTech deck with step lights in Saratoga Springs" /></a>
        <a href="/design-ideas/roofs-shade"><Photo src="/images/ideas/gable-roof-covered-deck-stone-columns" alt="Covered deck with a vaulted gable roof and stone columns" /></a>
        <a href="/design-ideas/lighting"><Photo src="/images/ideas/covered-deck-lighting-night" alt="Covered deck and stairs lit up at night" /></a>
      </div>
      <p style="margin-top:18px"><a class="btn btn-ghost" href="/project-showcase">See all projects</a></p>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <p class="eyebrow">Reviews</p>
      <h2>What homeowners say</h2>
      <Reviews />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2">
      <div>
        <p class="eyebrow">Materials</p>
        <h2>Brands we build with</h2>
        <p>We're a <a href="/certified-pro-installer">certified Pro Installer</a> (TimberTech Platinum) for TimberTech, Trex, Deckorators and Fortress, and an <a href="/owens-corning">Owens Corning Platinum</a> contractor for deck roofs. We'll walk you through the real differences in heat, color, warranty and budget.</p>
        <ul class="check-list">{brands.map((b) => <li>{b}</li>)}</ul>
        <a class="more" href="/design-ideas">Browse design ideas →</a>
      </div>
      <div>
        <p class="eyebrow">Service area</p>
        <h2>Where we build</h2>
        <p>Based in Saratoga Springs and building throughout Utah County.</p>
        <ul class="city-list">{cities.map((c) => <li><a href={`/service-areas/${c.slug}`}>{c.name}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap prose">
      <Faqs faqs={faqs} />
      <p><a href="/contact">Get your free estimate →</a></p>
    </div>
  </section>
</Base>

<style>
  .home-hero { background: var(--surface); padding: 56px 0; }
  .hero-video video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: inherit; }
  .hero-grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.15fr 1fr; } }
  .trust { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-weight: 600; color: var(--dark); font-size: 0.95rem; }
  .steps { padding-left: 1.2rem; }
  .steps li { margin-bottom: 0.8rem; }
  .align { align-items: center; }
  .city-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .more { font-weight: 700; }
</style>

<script>
  // Respect reduced-motion: show the poster frame instead of looping video.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.hero-video video').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
  }
</script>
