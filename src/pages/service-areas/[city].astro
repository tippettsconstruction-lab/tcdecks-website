---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import Reviews from '../../components/Reviews.astro';
import Faqs from '../../components/Faqs.astro';
import { cities, business, type City } from '../../data/site';
import { faqSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}
const { city } = Astro.props as { city: City };
const path = `/service-areas/${city.slug}`;
const county = city.county ?? 'Utah County';
const nearby = cities.filter((c) => c.slug !== city.slug && (c.county ?? 'Utah County') === county);
// Rotate through real TC Decks photos; cities with a confirmed local project use it.
const cityPhotos = ['two-tone-deck-mountain-view', 'cascading-wrap-around-deck-stairs', 'covered-two-story-deck-white-columns', 'pergola-deck-view', 'large-second-story-composite-deck', 'hot-tub-surround-deck-lights', 'gable-roof-entry-deck-wide-stairs', 'wrap-around-stairs-lights-dusk', 'blue-gray-composite-deck-sunset', 'gray-composite-deck-black-railing'];
const localPhotos: Record<string, { src: string; alt: string; project: string }> = {
  'saratoga-springs': { src: '/images/projects/saratoga-springs-dark-cocoa/aerial-timbertech-dark-cocoa-coconut-husk-deck-saratoga-springs', alt: 'TimberTech Dark Cocoa and Coconut Husk deck built by TC Decks in Saratoga Springs', project: 'saratoga-springs-dark-cocoa' },
  draper: { src: '/images/projects/draper-brownstone-slate-gray/draper-timbertech-brownstone-slate-gray-deck-built-in-bench', alt: 'Two-tone TimberTech deck with a built-in bench built by TC Decks in Draper', project: 'draper-brownstone-slate-gray' },
  santaquin: { src: '/images/projects/santaquin-pecan-pergola/santaquin-timbertech-pecan-deck-cedar-pergola', alt: 'TimberTech Pecan deck with a natural wood pergola built by TC Decks in Santaquin', project: 'santaquin-pecan-pergola' },
  sundance: { src: '/images/projects/sundance-cabin-english-walnut/sundance-cabin-timbertech-english-walnut-hideaway-sauna-deck', alt: 'TimberTech English Walnut sauna deck built by TC Decks at a Sundance cabin', project: 'sundance-cabin-english-walnut' },
  'pleasant-grove': { src: '/images/projects/pleasant-grove-trex-slide/pleasant-grove-trex-deck-twisty-tube-slide', alt: 'Trex deck with a twisty slide built by TC Decks in Pleasant Grove', project: 'pleasant-grove-trex-slide' },
  lindon: { src: '/images/projects/lindon-trex-pebble-grey/lindon-trex-pebble-grey-deck-stair-lights', alt: 'Trex Pebble Grey deck with lit stairs built by TC Decks in Lindon', project: 'lindon-trex-pebble-grey' },
  sandy: { src: '/images/projects/sandy-weathered-teak/sandy-timbertech-weathered-teak-covered-second-story-deck', alt: 'Covered TimberTech Weathered Teak deck built by TC Decks in Sandy', project: 'sandy-weathered-teak' },
  highland: { src: '/images/projects/highland-english-walnut-hideaway/highland-timbertech-vintage-english-walnut-timber-pavilion', alt: 'TimberTech English Walnut hot tub deck and timber pavilion built by TC Decks in Highland', project: 'highland-english-walnut-hideaway' },
};
const local = localPhotos[city.slug];
const photoSrc = local ? local.src : `/images/ideas/${cityPhotos[cities.indexOf(city) % cityPhotos.length]}`;
const photoAlt = local ? local.alt : `Deck built by TC Decks in ${county}`;
const faqs = [
  { q: `How long does a deck take to build in ${city.name}?`, a: 'Construction usually takes one to three weeks. We give you a schedule with your quote and keep you updated as we go.' },
  { q: `Do you offer free estimates in ${city.name}?`, a: `Yes. Estimates are free over the phone. If your ${city.name} project is a good fit, we schedule a site visit to measure and finalize the quote, and once it's booked we create a 3D design of your new deck.` },
];
---
<Base
  title={`Deck Builder in ${city.name}, UT | Composite Decks & Pergolas | TC Decks`}
  description={`Custom composite decks, pergolas, deck replacement and railing in ${city.name}, Utah. Local, licensed & insured deck builder since ${business.founded}. Free estimates and a 7-year workmanship warranty.`}
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Service Areas', path: '/service-areas' }, { name: city.name, path }])]}
>
  <PageHero eyebrow={`${city.name}, Utah`} title={`Deck builder in ${city.name}, UT`} lead={city.intro} crumbs={[{ name: 'Service Areas', path: '/service-areas' }, { name: city.name, path }]}>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Free {city.name} Estimate</a>
      <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="prose">
        <h2>Building decks in {city.name}</h2>
        <ul class="check-list">{city.notes.map((n) => <li>{n}</li>)}</ul>
      </div>
      <div><Photo src={photoSrc} alt={photoAlt} />{local && <p class="small"><a href={`/project-showcase#${local.project}`}>See this {city.name} project</a></p>}</div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap"><h2>Services in {city.name}</h2><ServiceCards /></div>
  </section>
  <section class="section">
    <div class="wrap"><h2>Reviews</h2><Reviews /></div>
  </section>
  <section class="section alt">
    <div class="wrap prose">
      <Faqs faqs={faqs} heading={`${city.name} deck questions`} />
      <p>Nearby: {nearby.map((c, i, arr) => <><a href={`/service-areas/${c.slug}`}>{c.name}</a>{i < arr.length - 1 ? ', ' : ''}</>)}</p>
    </div>
  </section>
</Base>
