---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { cities } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';
const groups = ['Utah County', 'Salt Lake County'].map((county) => ({ county, list: cities.filter((c) => (c.county ?? 'Utah County') === county) }));
---
<Base
  title="Deck Builder Service Areas in Utah County & Salt Lake County | TC Decks"
  description="TC Decks builds custom decks, pergolas and porches across Utah County and southern Salt Lake County, from Saratoga Springs, Lehi and Highland to Draper, Sandy, South Jordan and Herriman."
  schema={[breadcrumbSchema([{ name: 'Service Areas', path: '/service-areas' }])]}
>
  <PageHero eyebrow="Where we build" title="Deck builder serving Utah County and Salt Lake County" lead="We're based in Saratoga Springs and build throughout northern Utah County and the south end of Salt Lake County. Pick your city for local details and projects." crumbs={[{ name: 'Service Areas', path: '/service-areas' }]} />
  <section class="section">
    {groups.map((g) => (
      <div class="wrap county">
        <h2>{g.county}</h2>
        <div class="grid grid-3">
          {g.list.map((c) => (
            <div class="card">
              <h3 class="h3"><a href={`/service-areas/${c.slug}`}>Decks in {c.name}</a></h3>
              <p>{c.intro.split('. ')[0].replace(/\.$/, '')}.</p>
              <a class="more" href={`/service-areas/${c.slug}`}>{c.name} decks →</a>
            </div>
          ))}
        </div>
      </div>
    ))}
    <div class="wrap"><p style="margin-top:24px">Outside these cities? <a href="/contact">Ask us</a>, we often build nearby.</p></div>
  </section>
</Base>
<style>.county + .county { margin-top: 40px; } .h3 { font-size: 1.2rem; } .h3 a { color: inherit; text-decoration: none; } .more { font-weight: 700; text-decoration: none; }</style>
