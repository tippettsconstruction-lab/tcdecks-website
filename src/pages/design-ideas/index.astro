---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { ideaPages } from '../../data/designIdeas';
import { breadcrumbSchema } from '../../lib/schema';

const steps = [
  { name: 'Layout', text: 'How you’ll use the space, traffic flow, sun, views, size and height.' },
  { name: 'Materials & color', text: 'Decking, railing, fascia and accent colors.' },
  { name: 'Features', text: 'Shade, lighting, kitchens, seating, hot tubs and storage.' },
  { name: 'Build', text: '3D rendering once booked, then construction and final walkthrough.' },
];
---
<Base
  title="Deck Design Ideas & Selection Guide | TC Decks Utah"
  description="Browse deck design ideas from TC Decks: TimberTech colors, railings, roofs and pergolas, lighting, add-ons and the details that make a deck last. Plan your Utah deck."
  schema={[breadcrumbSchema([{ name: 'Design Ideas', path: '/design-ideas' }])]}
>
  <PageHero eyebrow="Design & selection guide" title="Deck design ideas" lead="Browse the options we build so you can picture your deck and tell us what you like. Bring your favorites to your free phone estimate." crumbs={[{ name: 'Design Ideas', path: '/design-ideas' }]} />
  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        {ideaPages.map((p) => (
          <a class="idea card" href={`/design-ideas/${p.slug}`}>
            <Photo src={p.cover} alt={p.name} label={p.name} />
            <h2 class="h3">{p.name}</h2>
            <p>{p.intro.split('. ')[0]}.</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap">
      <h2>Planning your deck in four steps</h2>
      <ol class="grid grid-3 steps">
        {steps.map((s, i) => <li class="card"><span class="num">{i + 1}</span><h3>{s.name}</h3><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>
</Base>
<style>
  .idea { text-decoration: none; color: inherit; padding: 0; overflow: hidden; }
  .idea :global(.photo) { border-radius: 0; }
  .idea h2, .idea p { padding: 0 18px; }
  .idea h2 { margin-top: 14px; font-size: 1.25rem; }
  .idea:hover h2 { color: var(--accent); }
  .steps { list-style: none; padding: 0; }
  .num { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 800; margin-bottom: 8px; }
</style>
