---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Faqs from '../components/Faqs.astro';
import { business } from '../data/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const faqs = [
  { q: 'Who provides the financing?', a: 'We offer financing through Wisetack, a consumer financing platform built for home service companies. Wisetack works with lending partners who make the loans.' },
  { q: 'How much can I borrow?', a: 'Wisetack loans go up to $65,000, which covers most new decks, covered decks and railing upgrades.' },
  { q: 'How do I apply?', a: 'Use the Check your options button on this page to open our Wisetack application. It takes a few minutes on your phone, and you will see your options right away. You can also call us and we will send you the link.' },
  { q: 'Can I use financing for part of the project?', a: 'Yes. You can finance the whole project or just part of it and pay the rest another way.' },
];
---
<Base
  title="Deck Financing in Utah County | Loans up to $65,000 | TC Decks"
  description="Finance your new deck, covered deck or railing with TC Decks through Wisetack. Quick application on your phone, loans up to $65,000. Serving Saratoga Springs and Utah County."
  schema={[breadcrumbSchema([{ name: 'Financing', path: '/financing' }]), faqSchema(faqs)]}
>
  <PageHero eyebrow="Financing" title="Build your deck now, pay over time" lead="We offer financing through Wisetack. It's quick to apply from your phone, and loans go up to $65,000." crumbs={[{ name: 'Financing', path: '/financing' }]} />
  <section class="section">
    <div class="wrap grid grid-2">
      <div class="prose">
        <h2>How it works</h2>
        <ol>
          <li><strong>Get your free estimate</strong> over the phone so you know what your project involves.</li>
          <li><strong>Apply in a few minutes.</strong> Use the <a href="https://wisetack.us/#/97z1eyt/prequalify" target="_blank" rel="noopener">Wisetack application</a> on your phone or computer.</li>
          <li><strong>Pick your plan.</strong> You'll see your loan options and choose the one that fits your budget.</li>
          <li><strong>We build.</strong> Once you're approved and the job is booked, we schedule your build and send your 3D design.</li>
        </ol>
        <h2>Why homeowners use it</h2>
        <ul class="check-list">
          <li>Loans up to $65,000</li>
          <li>Simple application on your phone</li>
          <li>Build the deck you actually want instead of a smaller one now and an add-on later</li>
          <li>Finance all or part of your project</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" href="https://wisetack.us/#/97z1eyt/prequalify" target="_blank" rel="noopener">Check your options</a>
          <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <p class="small">All financing is subject to credit approval. Your terms may vary. Payment options through Wisetack are provided by our lending partners.</p>
      </div>
      <Photo src="/images/projects/saratoga-springs-brownstone-covered/saratoga-springs-covered-deck-timbertech-brownstone-lighting" alt="Covered TimberTech deck with lighting built by TC Decks in Saratoga Springs" />
    </div>
  </section>
  <section class="section alt"><div class="wrap"><Faqs faqs={faqs} /></div></section>
</Base>
