---
import Service from '../layouts/Service.astro';
import Photo from '../components/Photo.astro';

const faqs = [
  { q: 'Should I repair or replace my deck?', a: 'If the footings and framing are solid, repairs or a resurface can make sense. Soft or rotted joists, loose ledger connections, or footings that have shifted usually mean it is time to rebuild. We inspect and give you both options when both are reasonable.' },
  { q: 'Can a heavy winter damage my deck?', a: 'Yes. Heavy snow loads, ice and freeze-thaw cycles can crack boards, loosen fasteners and damage framing and footings. Check for sagging, bouncy spots and loose railing each spring.' },
  { q: 'How often should a deck be inspected?', a: 'Once a year, ideally in spring. Look at the ledger board where the deck meets the house, the posts and footings, the railing, and the stairs.' },
];
---
<Service
  slug="deck-repair"
  name="Deck Repair & Rebuild"
  title="Deck Repair & Replacement in Utah County | TC Decks"
  description="Deck repair, resurfacing and full tear-out and rebuild in Saratoga Springs, Lehi, Orem and Utah County. Snow damage, rotted framing, loose railing. Free inspection and estimate."
  h1="Deck repair and replacement"
  lead="Utah's snow and freeze-thaw cycles are hard on decks. Whether you need a few boards and a railing fixed or a full tear-out and rebuild, we'll tell you honestly which makes sense."
  faqs={faqs}
>
  <h2>Signs your deck needs attention</h2>
  <ul class="check-list">
    <li>Soft, spongy or bouncy spots when you walk</li>
    <li>Loose or wobbly railing or stairs</li>
    <li>Rot at the posts, ledger board or joists</li>
    <li>Cracked, warped or splintering boards</li>
    <li>Rusty or popped fasteners and connectors</li>
    <li>Gaps where the deck meets the house</li>
  </ul>
  <Photo alt="Old wood deck before replacement" label="Photo: before/after deck rebuild" />

  <h2>What we do</h2>
  <ul class="check-list">
    <li><strong>Repairs:</strong> replace damaged boards, joists, posts, stairs and railing.</li>
    <li><strong>Resurfacing:</strong> new composite decking and railing on a sound existing frame.</li>
    <li><strong>Tear-out and rebuild:</strong> full demolition and haul-away, new footings and framing, built to current code.</li>
  </ul>
  <p>A rebuild is also a chance to rethink the layout. See our <a href="/custom-deck-design-construction">custom deck design</a> process or <a href="/composite-decks">composite options</a>.</p>
</Service>
