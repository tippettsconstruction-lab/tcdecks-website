---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faqs from '../components/Faqs.astro';
import { business } from '../data/site';
import { faqSchema, breadcrumbSchema } from '../lib/schema';

// Kept at its old URL because it already ranks; deliberately has no prices (owner's choice).
const factors = [
  { name: 'Size and shape', detail: 'Square footage is the biggest driver. Angles, curves and multiple levels add framing and labor.' },
  { name: 'Height off the ground', detail: 'Taller decks need longer posts, more bracing, bigger footings and longer stairs.' },
  { name: 'Decking material', detail: 'Pressure-treated wood costs least up front. Composite and PVC cost more to install but skip the staining and sealing.' },
  { name: 'Railing', detail: 'Vinyl and composite railing are usually the most budget-friendly; aluminum and cable cost more but last and look great.' },
  { name: 'Stairs and landings', detail: 'Each step and landing adds materials and labor, especially on second-story decks.' },
  { name: 'Add-ons', detail: 'Pergolas, lighting, built-in benches, under-deck drainage and hot tub framing.' },
  { name: 'Removing an old deck', detail: 'Demolition and haul-away, plus patching the siding where the old deck was attached.' },
  { name: 'Site conditions', detail: 'Slopes and tight access affect the final number.' },
];
const faqs = [
  { q: 'Do you charge for estimates?', a: 'No. Estimates are free over the phone. If your project is a good fit, we follow up with a site visit to measure and finalize the quote.' },
  { q: 'Is composite worth the extra cost?', a: 'For most Utah homeowners planning to stay more than a few years, yes. Composite avoids the recurring cost and work of staining and sealing and holds up better to sun and snow.' },
  { q: 'How can I keep my deck project on budget?', a: 'Simple rectangular shapes, a lower height, a good-better-best composite line that fits your budget, and adding features like lighting later are all ways to save. We are happy to show you options at the estimate.' },
  { q: 'What warranty comes with my deck?', a: 'Every deck includes a 7-year workmanship warranty, plus the manufacturer warranty on your decking and railing.' },
];
const path = '/how-much-does-a-deck-cost-in-utah';
---
<Base
  title="How Much Does a Deck Cost in Utah? | TC Decks"
  description="What drives the cost of a new deck in Utah County: size, height, materials, railing, stairs and add-ons. Get a free, no-obligation estimate from TC Decks."
  schema={[faqSchema(faqs), breadcrumbSchema([{ name: 'Deck Costs', path }])]}
>
  <PageHero eyebrow="Planning your budget" title="How much does a deck cost in Utah?" lead="Every deck is different, so the honest answer is: it depends on a handful of choices. Here's what moves the price, and how to get an exact number for free." crumbs={[{ name: 'Deck Costs', path }]}>
    <div class="btn-row">
      <a class="btn btn-primary" href="/contact">Get a Free Estimate</a>
      <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="wrap prose">
      <h2>What affects the cost of a deck</h2>
      <div class="grid grid-2">
        {factors.map((f) => <div class="card"><h3>{f.name}</h3><p>{f.detail}</p></div>)}
      </div>

      <h2>Wood vs. composite over time</h2>
      <p>Wood is cheaper to build, but in Utah's sun and snow it needs sanding, staining and sealing every few years. Composite costs more on day one and then needs little more than washing. Read more in <a href="/blog/wood-vs-composite-performance-in-utahs-weather">wood vs. composite in Utah's weather</a>.</p>

      <h2>Get an exact number</h2>
      <p>The fastest way to know what your deck will cost is a free phone estimate. Tell us the size, height and materials you have in mind and we'll give you a ballpark. If it's a good fit, we'll come measure and finalize the quote. <a href="/contact">Request an estimate</a> or call <a href={business.phoneHref}>{business.phone}</a>.</p>

      <Faqs faqs={faqs} />
    </div>
  </section>
</Base>
