---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../lib/schema';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base
  title="Deck Building Tips & Guides for Utah | TC Decks Blog"
  description="Practical advice on deck materials, costs, design and maintenance for Utah County homeowners, from a local deck builder."
  schema={[breadcrumbSchema([{ name: 'Blog', path: '/blog' }])]}
>
  <PageHero eyebrow="Blog" title="Deck guides for Utah homeowners" crumbs={[{ name: 'Blog', path: '/blog' }]} />
  <section class="section">
    <div class="wrap grid grid-2">
      {posts.map((p) => (
        <article class="card">
          <h2 class="h3"><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
          <p class="date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
          <p>{p.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
<style>.h3 { font-size: 1.25rem; } .h3 a { color: inherit; text-decoration: none; } .date { color: var(--ink-soft); font-size: .9rem; }</style>
