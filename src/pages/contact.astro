---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { business } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
---
<Base
  title="Get a Free Deck Estimate | Contact TC Decks | 801-472-8939"
  description="Request a free deck estimate from TC Decks in Saratoga Springs, Utah. Call 801-472-8939 or send us your project details."
  schema={[breadcrumbSchema([{ name: 'Contact', path: '/contact' }])]}
>
  <PageHero eyebrow="Contact" title="Get a free estimate" lead="Estimates are free and done over the phone. Tell us about your project and we'll give you a ballpark. If it's a good fit, we'll schedule a site visit to measure and finalize the details." crumbs={[{ name: 'Contact', path: '/contact' }]} />
  <section class="section">
    <div class="wrap grid grid-2">
      <QuoteForm />
      <div>
        <h2>Prefer to call?</h2>
        <p class="big"><a href={business.phoneHref}>{business.phone}</a></p>
        <p><strong>Email:</strong> <a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p><strong>Hours:</strong> {business.hours}</p>
        <p><strong>Based in:</strong> Saratoga Springs, UT, serving Utah County and Salt Lake County along the Wasatch Front. See our <a href="/service-areas">service areas</a>.</p>
        <h2>Want to sketch it first?</h2>
        <p>Use our <a href="/deck-planner">Deck Planner</a> to lay out the size, shape, stairs, decking color and railing, then send the drawing with your request.</p>
        <p class="small">Utah Contractor License #{business.license} · Licensed &amp; insured</p>
      </div>
    </div>
  </section>
</Base>
<style>.big { font-size: 1.8rem; font-weight: 800; } .big a { text-decoration: none; color: var(--dark); } .small { font-size: .9rem; color: var(--ink-soft); }</style>
