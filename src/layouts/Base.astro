---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, cities } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  noindex?: boolean;
}

const { title, description, image = '/og-default.jpg', schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), business.url).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${business.url}/#business`,
  name: business.name,
  alternateName: business.legalName,
  url: business.url,
  telephone: `+1-${business.phone}`,
  email: business.email,
  founder: { '@type': 'Person', name: business.owner },
  foundingDate: String(business.founded),
  openingHours: business.hoursSchema,
  priceRange: '$$',
  image: new URL(image, business.url).href,
  logo: new URL('/images/brand/icon-512.png', business.url).href,
  address: { '@type': 'PostalAddress', addressLocality: business.city, addressRegion: business.region, addressCountry: 'US' },
  areaServed: cities.map((c) => ({ '@type': 'City', name: `${c.name}, UT` })),
  aggregateRating: { '@type': 'AggregateRating', ratingValue: business.rating.value, reviewCount: business.rating.count },
  sameAs: Object.values(business.social),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, business.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/images/brand/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/brand/icon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: #fff; padding: 8px; z-index: 100; }
</style>
