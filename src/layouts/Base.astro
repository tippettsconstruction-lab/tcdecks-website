---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business, cities } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, image = '/og-default.jpg', schema = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), business.url).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${business.url}/#business`,
  name: business.name,
  alternateName: business.legalName,
  description: business.summary,
  url: business.url,
  telephone: `+1-${business.phone}`,
  founder: { '@type': 'Person', name: business.owner },
  foundingDate: String(business.founded),
  openingHours: business.hoursSchema,
  priceRange: '$$',
  image: new URL(image, business.url).href,
  logo: new URL('/images/brand/icon-512.png', business.url).href,
  address: { '@type': 'PostalAddress', addressLocality: business.city, addressRegion: business.region, addressCountry: 'US' },
  hasMap: business.social.google,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Utah County, UT' },
    { '@type': 'AdministrativeArea', name: 'Salt Lake County, UT' },
    ...cities.map((c) => ({ '@type': 'City', name: `${c.name}, UT` })),
  ],
  sameAs: Object.values(business.social),
  knowsAbout: business.specialties,
  hasCredential: [`Utah Contractor License #${business.license}`, ...business.credentials].map((name) => ({ '@type': 'EducationalOccupationalCredential', name })),
  memberOf: business.memberships.map((name) => ({ '@type': 'Organization', name })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, business.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/images/brand/icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/brand/icon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {business.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${business.gaId}`}></script>
        <script is:inline define:vars={{ gaId: business.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
          // Lead events: phone taps and estimate form submissions.
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="tel:"]');
            if (a) gtag('event', 'phone_call_click', { link_url: a.href, page_path: location.pathname });
          });
          document.addEventListener('submit', function (e) {
            var f = e.target;
            if (f && f.getAttribute('name') === 'estimate') gtag('event', 'generate_lead', { form_name: 'estimate', page_path: location.pathname });
          });
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <nav class="mobile-cta" aria-label="Contact TC Decks">
      <a class="btn btn-ghost" href={business.phoneHref}>Call {business.phone}</a>
      <a class="btn btn-primary" href="/contact">Free Estimate</a>
    </nav>
  </body>
</html>

<style is:global>
  .mobile-cta { display: none; }
  @media (max-width: 720px) {
    .mobile-cta {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
      padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
      background: var(--dark); border-top: 3px solid var(--accent);
    }
    .mobile-cta .btn { display: flex; align-items: center; justify-content: center; text-align: center; padding: 0.6rem 8px; min-height: 48px; font-size: 0.95rem; }
    .mobile-cta .btn-ghost { color: #fff; }
    body::after { content: ""; display: block; height: calc(68px + env(safe-area-inset-bottom)); background: var(--dark); }
  }
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 16px; top: 16px; background: #fff; padding: 8px; z-index: 100; }
</style>
